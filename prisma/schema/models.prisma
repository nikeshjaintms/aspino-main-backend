// ─────────────────────────────────────────────────────────────
// models.prisma — All Database Models
// ─────────────────────────────────────────────────────────────


// ══════════════════════════════════════════════════════════════
// ── USERS & AUTH
// ══════════════════════════════════════════════════════════════

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      String    @default("USER") // ADMIN, HR, EMPLOYEE
  createdAt DateTime  @default(now())
  employee  Employee?
}


// ══════════════════════════════════════════════════════════════
// ── EMPLOYEE MANAGEMENT
// ══════════════════════════════════════════════════════════════

model Employee {
  id                String               @id @default(uuid())
  employeeId        String               @unique // e.g. ASP-2026-0001
  userId            String?              @unique
  user              User?                @relation(fields: [userId], references: [id])
  firstName         String
  lastName          String
  email             String               @unique
  department        String
  designation       String
  managerId         String?
  dateOfJoining     DateTime
  probationEnd      DateTime?
  probationStatus   String               @default("UNDER_REVIEW") // UNDER_REVIEW, CONFIRMED, EXTENDED
  status            String               @default("ACTIVE")       // ONBOARDING, ACTIVE, EXITING, RELIEVED
  createdAt         DateTime             @default(now())
  documents         OnboardingDocument[]
  induction         InductionSchedule?
  systemAccess      SystemAccess?
  roster            ShiftRoster[]
  attendance        Attendance[]
  leaveBalances     LeaveBalance[]
  leaveApplications LeaveApplication[]
  leaveLedger       LeaveLedger[]
  goals             EmployeeGoal[]
  appraisalReviews  AppraisalReview[]
  trainings         TrainingRecord[]
  exitProcess       ExitProcess?
}

model Department {
  id           String           @id @default(uuid())
  name         String           @unique
  createdAt    DateTime         @default(now())
  requisitions JobRequisition[]
}


// ══════════════════════════════════════════════════════════════
// ── RECRUITMENT
// ══════════════════════════════════════════════════════════════

model JobRequisition {
  id            String      @id @default(uuid())
  title         String
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id])
  headcount     Int
  justification String
  status        String      @default("PENDING") // PENDING, APPROVED, REJECTED, FULFILLED
  raisedBy      String
  createdAt     DateTime    @default(now())
  candidates    Candidate[]
}

model Candidate {
  id            String              @id @default(uuid())
  name          String
  email         String              @unique
  phone         String?
  resumeUrl     String?
  source        String              // Referral, Portal, Agency, LinkedIn, Walk-in, Website
  status        String              @default("SOURCED") // SOURCED, INTERVIEWING, SELECTED, REJECTED, OFFERED, ACCEPTED
  requisitionId String
  requisition   JobRequisition      @relation(fields: [requisitionId], references: [id])
  createdAt     DateTime            @default(now())
  schedules     InterviewSchedule[]
  offer         OfferLetter?
}

model InterviewSchedule {
  id          String              @id @default(uuid())
  candidateId String
  candidate   Candidate           @relation(fields: [candidateId], references: [id])
  roundName   String              // e.g. Technical, HR, Manager
  scheduledAt DateTime
  panelists   String              // Comma separated panelist names
  status      String              @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  feedbacks   InterviewFeedback[]
}

model InterviewFeedback {
  id             String            @id @default(uuid())
  scheduleId     String
  schedule       InterviewSchedule @relation(fields: [scheduleId], references: [id])
  panelistName   String
  rating         Int
  comments       String
  recommendation String            // SELECT, REJECT, HOLD
  createdAt      DateTime          @default(now())
}

model OfferLetter {
  id          String    @id @default(uuid())
  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  role        String
  salary      Float
  joiningDate DateTime
  status      String    @default("GENERATED") // GENERATED, SENT, ACCEPTED, DECLINED
  createdAt   DateTime  @default(now())
}


// ══════════════════════════════════════════════════════════════
// ── ONBOARDING
// ══════════════════════════════════════════════════════════════

model OnboardingDocument {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  documentType String   // Aadhaar, PAN, Passport, Address Proof, Education Certificates, Previous Employment, Bank Details, Photo
  status       String   @default("PENDING") // PENDING, SUBMITTED, VERIFIED, REJECTED
  fileUrl      String?
  verifiedAt   DateTime?
}

model InductionSchedule {
  id          String   @id @default(uuid())
  employeeId  String   @unique
  employee    Employee @relation(fields: [employeeId], references: [id])
  scheduledAt DateTime
  trainer     String
  status      String   @default("SCHEDULED") // SCHEDULED, COMPLETED
}

model SystemAccess {
  id            String   @id @default(uuid())
  employeeId    String   @unique
  employee      Employee @relation(fields: [employeeId], references: [id])
  erpLogin      Boolean  @default(false)
  email         Boolean  @default(false)
  attendanceApp Boolean  @default(false)
  vpn           Boolean  @default(false)
}


// ══════════════════════════════════════════════════════════════
// ── ATTENDANCE & SHIFTS
// ══════════════════════════════════════════════════════════════

model Shift {
  id        String        @id @default(uuid())
  name      String        // Morning, Evening, Night, Flexible
  startTime String        // HH:MM
  endTime   String
  rosters   ShiftRoster[]
}

model ShiftRoster {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  shiftId    String
  shift      Shift    @relation(fields: [shiftId], references: [id])
  date       DateTime
}

model Attendance {
  id                 String    @id @default(uuid())
  employeeId         String
  employee           Employee  @relation(fields: [employeeId], references: [id])
  date               DateTime
  checkIn            DateTime?
  checkOut           DateTime?
  status             String    @default("PRESENT") // PRESENT, ABSENT, LATE, HALFDAY
  shiftId            String?
  shiftName          String?
  totalWorkHours     Float?
  otHours            Float?    @default(0)
  lateHours          Float?    @default(0)
  earlyGoingHours    Float?    @default(0)
  presentDay         Float?    @default(1.0)
  isHalfDay          Boolean?  @default(false)
  isSundayPresent    Boolean?  @default(false)
  isFullNightPresent Boolean?  @default(false)
  isHolidayPresent   Boolean?  @default(false)
  captureMethod      String?   @default("BIOMETRIC")
}


// ══════════════════════════════════════════════════════════════
// ── LEAVE MANAGEMENT
// ══════════════════════════════════════════════════════════════

model LeaveBalance {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  leaveType  String   // Casual, Sick, Earned
  allocated  Int
  used       Int      @default(0)
}

model LeaveApplication {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
}

model LeaveLedger {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  leaveType  String
  change     Int      // positive for allocation, negative for usage
  reason     String
  createdAt  DateTime @default(now())
}

model Holiday {
  id   String   @id @default(uuid())
  name String
  date DateTime
}

model DepartmentLeaveMaster {
  id            String   @id @default(uuid())
  department    String
  fiscalYear    String
  casualLeave   Int
  sickLeave     Int
  earnedLeave   Int
  otherLeave    Int      @default(0)
  totalLeave    Int
  effectiveFrom DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([department, fiscalYear])
}


// ══════════════════════════════════════════════════════════════
// ── PERFORMANCE & APPRAISALS
// ══════════════════════════════════════════════════════════════

model AppraisalCycle {
  id               String            @id @default(uuid())
  name             String            // e.g. FY26 Annual
  startDate        DateTime
  endDate          DateTime
  status           String            @default("ACTIVE") // ACTIVE, CLOSED
  goals            EmployeeGoal[]
  appraisalReviews AppraisalReview[]
}

model EmployeeGoal {
  id          String         @id @default(uuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id])
  cycleId     String
  cycle       AppraisalCycle @relation(fields: [cycleId], references: [id])
  title       String
  description String
  weightage   Int
  status      String         @default("PENDING") // PENDING, APPROVED, COMPLETED
}

model AppraisalReview {
  id              String         @id @default(uuid())
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id])
  cycleId         String
  cycle           AppraisalCycle @relation(fields: [cycleId], references: [id])
  selfRating      Float?
  selfComments    String?
  managerRating   Float?
  managerComments String?
  finalRating     Float?
  status          String         @default("DRAFT") // DRAFT, SELF_REVIEW, MANAGER_REVIEW, COMPLETED
}


// ══════════════════════════════════════════════════════════════
// ── TRAINING
// ══════════════════════════════════════════════════════════════

model TrainingRecord {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  trainingName   String    // e.g. Pharma GMP Compliance
  trainingType   String    // COMPLIANCE, TECHNICAL, SOFT_SKILLS
  completionDate DateTime
  expiryDate     DateTime?
  status         String    @default("COMPLETED") // COMPLETED, EXPIRED, PENDING
}


// ══════════════════════════════════════════════════════════════
// ── EXIT MANAGEMENT
// ══════════════════════════════════════════════════════════════

model ExitProcess {
  id               String                  @id @default(uuid())
  employeeId       String                  @unique
  employee         Employee                @relation(fields: [employeeId], references: [id])
  type             String                  // RESIGNATION, TERMINATION
  resignationDate  DateTime
  noticePeriodDays Int
  lastWorkingDay   DateTime
  reason           String
  status           String                  @default("INITIATED") // INITIATED, CLEARANCE_IN_PROGRESS, SETTLED, COMPLETED
  clearances       ClearanceTask[]
  settlement       FullAndFinalSettlement?
}

model ClearanceTask {
  id              String      @id @default(uuid())
  exitProcessId   String
  exitProcess     ExitProcess @relation(fields: [exitProcessId], references: [id])
  department      String      // IT, Stores, Finance, Library, HR, Admin, Security
  taskDescription String
  status          String      @default("PENDING") // PENDING, CLEARED
  clearedAt       DateTime?
  clearedBy       String?
}

model FullAndFinalSettlement {
  id              String      @id @default(uuid())
  exitProcessId   String      @unique
  exitProcess     ExitProcess @relation(fields: [exitProcessId], references: [id])
  pendingSalary   Float
  leaveEncashment Float
  bonus           Float
  recoveries      Float
  netPayable      Float
  paymentStatus   String      @default("UNPAID") // UNPAID, PAID
  settlementDate  DateTime?
}


// ══════════════════════════════════════════════════════════════
// ── GATE PASS  (uses enums: GatePassType, GatePassStatus)
// ══════════════════════════════════════════════════════════════

model PassCategory {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  type        GatePassType  // → enum in enums.prisma
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  gatePasses  GatePass[]
}

model GatePass {
  id                    String         @id @default(uuid())
  passNumber            String         @unique
  type                  GatePassType   // → enum in enums.prisma
  categoryId            String
  category              PassCategory   @relation(fields: [categoryId], references: [id])
  status                GatePassStatus @default(GATE_IN) // → enum in enums.prisma

  // Vehicle & Driver Details
  imageUrl              String?
  vehicleNumber         String
  driverName            String
  driverContact         String?
  transporterName       String?

  // Inward specific fields
  supplierSource        String?
  deliveryChallanNumber String?
  declaredQuantity      String?
  poNumber              String?
  grnNumber             String?

  // Outward specific fields
  invoiceNumber         String?
  coaGenerated          Boolean        @default(false)
  purpose               String?        // e.g. Equipment repair, Sample dispatch, Sales

  // Timestamps
  timeIn                DateTime       @default(now())
  timeOut               DateTime?
  notes                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}


// ══════════════════════════════════════════════════════════════
// ── BANK & SUPPLIER
// ══════════════════════════════════════════════════════════════

model Bank {
  id        String     @id @default(uuid())
  name      String     @unique
  isActive  Boolean    @default(true)
  suppliers Supplier[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Supplier {
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String
  address            String?
  gstNo              String
  contactPerson      String?
  phone              String?
  email              String?
  approvedCategories String[]
  approvalStatus     String   @default("Approved")

  bankId        String?
  bank          Bank?    @relation(fields: [bankId], references: [id]) // → Bank.id (UUID)
  accountNumber String?
  ifscCode      String?
  accountName   String?

  rating    Float    @default(5.0)
  history   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vendor {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  serviceType       String
  address           String?
  contactName       String?
  mobile            String?
  email             String?
  contractReference String?
  approvalStatus    String   @default("Approved")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ══════════════════════════════════════════════════════════════
// ── CUSTOMER MASTER
// ══════════════════════════════════════════════════════════════

model Customer {
  id              String   @id @default(uuid())
  customerCode    String   @unique
  name            String
  billingAddress  String?
  shippingAddress String?
  gstNo           String?
  creditTerms     String?  // e.g. "Net 30 Days", "Net 15 Days", "Immediate", "Advance", etc.
  contactPerson   String?
  email           String?
  phone           String?
  customerType    String   @default("DOMESTIC") // "DOMESTIC" | "EXPORT"
  isDomestic      Boolean  @default(true)
  country         String?  @default("India")
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


// ══════════════════════════════════════════════════════════════
// ── AUDIT / ACTIVITY LOG
// ══════════════════════════════════════════════════════════════

model ActivityLog {
  id           String   @id @default(uuid())
  userId       String?  // The user ID who performed the action, null if guest/system
  userEmail    String?  // User email
  userName     String?  // User name
  userRole     String?  // User role
  action       String   // e.g. "CREATE_GATE_PASS", "LOGIN", "DELETE_USER"
  entityType   String?  // e.g. "GatePass", "User", "PassCategory"
  entityId     String?  // ID of the target resource
  method       String   // GET, POST, PUT, PATCH, DELETE
  url          String   // request url path
  ip           String?  // IP address of the client
  userAgent    String?  // User agent
  statusCode   Int      // HTTP response status code
  requestBody  Json?    // Serialized request body (sanitized)
  queryParams  Json?    // Serialized query params
  routeParams  Json?    // Serialized route parameters
  responseBody Json?    // Serialized response body (sanitized, omitted if too large)
  createdAt    DateTime @default(now())
}


// ══════════════════════════════════════════════════════════════
// ── PRODUCT CATEGORY, SUB-CATEGORY & PRODUCT MASTERS
// ══════════════════════════════════════════════════════════════

model ProductCategory {
  id            String               @id @default(uuid())
  categoryCode  String               @unique
  categoryName  String
  description   String?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  subCategories ProductSubCategory[]
  products      Product[]
}

model ProductSubCategory {
  id              String          @id @default(uuid())
  subCategoryCode String          @unique
  subCategoryName String
  categoryId      String
  category        ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  description     String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  products        Product[]
}

model Product {
  id                 String              @id @default(uuid())
  productCode        String              @unique
  name               String
  categoryId         String
  category           ProductCategory     @relation(fields: [categoryId], references: [id])
  subCategoryId      String?
  subCategory        ProductSubCategory? @relation(fields: [subCategoryId], references: [id])
  uom                String              // e.g. TABLET, CAPSULE, VIAL, STRIP, BOTTLE, KG, LTR
  shelfLife          String              // e.g. "24 Months", "36 Months"
  storageCondition   String              // e.g. "Store below 25°C", "2-8°C (Cold Storage)"
  standardCost       Float               @default(0.0)
  hsnCode            String              // e.g. "30049099"
  qcSpecification    String?             // Linked QC Specification / Standard description
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// ══════════════════════════════════════════════════════════════
// ── UOM MASTER (Unit of Measurement)
// ══════════════════════════════════════════════════════════════

model Uom {
  id               String   @id @default(uuid())
  uomCode          String   @unique
  uomName          String
  conversionFactor Float?   @default(1.0)
  description      String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ══════════════════════════════════════════════════════════════
// ── PACKING MATERIAL MASTER
// ══════════════════════════════════════════════════════════════

model PackingMaterial {
  id                  String   @id @default(uuid())
  materialCode        String   @unique // e.g. "PKG-ALU-01", "PKG-BTL-100ML"
  type                String   @default("PRIMARY") // "PRIMARY", "SECONDARY", "TERTIARY"
  description         String
  approvedSuppliers   Json?    // Array of approved supplier names / IDs or objects
  linkedSpecification String?  // Linked QC Specification Code or ID
  uom                 String   // e.g. "ROLL", "NOS", "KG", "BOX", "MTR"
  standardCost        Float    @default(0.0)
  minimumStock        Float?   @default(0.0)
  storageCondition    String?  @default("Ambient")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ══════════════════════════════════════════════════════════════
// ── QC SPECIFICATION MASTER
// ══════════════════════════════════════════════════════════════

model QcSpecification {
  id                  String    @id @default(uuid())
  specCode            String    @unique // e.g. "QC-SPEC-001", "SPEC-PCM-500"
  productMaterialCode String    // Product or Material Code (e.g. "PRD-PCM-500", "PKG-ALU-01")
  itemName            String    // Product or Material Name
  itemType            String    @default("PRODUCT") // "PRODUCT", "PACKING_MATERIAL", "RAW_MATERIAL"
  testParameters      Json      // Array of test parameter objects: [{ parameterName, testMethod, acceptableLimits, uom }]
  testMethod          String?   // Overall standard or testing reference (e.g. "IP / BP / USP")
  acceptableLimits    String?   // General acceptance criteria / summary
  versionNo           String    @default("v1.0") // e.g. "v1.0", "Rev 02"
  effectiveDate       DateTime  @default(now())
  reviewDate          DateTime?
  status              String    @default("ACTIVE") // "ACTIVE", "DRAFT", "SUPERSEDED", "OBSOLETE"
  preparedBy          String?
  approvedBy          String?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ══════════════════════════════════════════════════════════════
// ── WAREHOUSE / STORAGE LOCATION MASTER
// ══════════════════════════════════════════════════════════════

model StorageLocation {
  id               String   @id @default(uuid())
  locationCode     String   @unique // e.g. "LOC-RM-A101", "LOC-COLD-01", "LOC-FG-R02"
  locationName     String   // e.g. "Raw Material Bay A-01", "Cold Room 1 (2-8°C)"
  warehouse        String?  @default("Main Warehouse") // e.g. "Central Warehouse", "Warehouse A"
  storageCondition String   @default("AMBIENT") // "AMBIENT", "COOL", "COLD_CHAIN", "FROZEN", "CONTROLLED_ROOM_TEMPERATURE"
  capacity         String   // e.g. "500 Pallets", "1000 Boxes", "50 Drums"
  linkedStoreType  String   @default("RAW_MATERIAL_STORE") // "RAW_MATERIAL_STORE", "PACKAGING_STORE", "FINISHED_GOODS_STORE", "QUARANTINE_STORE", "REJECTION_STORE", "IN_TRANSIT_STORE"
  temperatureRange String?  // e.g. "2°C - 8°C", "15°C - 25°C", "Below -20°C"
  humidityRange    String?  // e.g. "NMT 60% RH"
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}



