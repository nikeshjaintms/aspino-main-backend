// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GatePassType {
  INWARD
  OUTWARD
}

enum GatePassStatus {
  GATE_IN
  COMPLETED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())
}

model PassCategory {
  id          Int          @id @default(autoincrement())
  name        String
  code        String       @unique
  type        GatePassType
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  gatePasses  GatePass[]
}

model GatePass {
  id                    Int            @id @default(autoincrement())
  passNumber            String         @unique
  type                  GatePassType
  categoryId            Int
  category              PassCategory   @relation(fields: [categoryId], references: [id])
  status                GatePassStatus @default(GATE_IN)

  // Vehicle & Driver Details
  imageUrl              String?
  vehicleNumber         String
  driverName            String
  driverContact         String?
  transporterName       String?

  // Inward specific fields
  supplierSource        String?
  deliveryChallanNumber String?
  declaredQuantity      String?
  poNumber              String?
  grnNumber             String?

  // Outward specific fields
  invoiceNumber         String?
  coaGenerated          Boolean        @default(false)
  purpose               String?        // e.g. Equipment repair, Sample dispatch, Sales

  // Automatic Timestamps
  timeIn                DateTime       @default(now())
  timeOut               DateTime?
  notes                 String?
 

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model Bank {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  isActive  Boolean    @default(true)
  suppliers Supplier[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Supplier {
  id                 Int      @id @default(autoincrement())
  code               String   @unique
  name               String
  address            String?
  gstNo              String
  contactPerson      String?
  phone              String?
  email              String?
  approvedCategories String[]
  approvalStatus     String   @default("Approved")
  
  bankId             Int?
  bank               Bank?    @relation(fields: [bankId], references: [id])
  accountNumber      String?
  ifscCode           String?
  accountName        String?
  
  rating             Float    @default(5.0)
  history            String?
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

